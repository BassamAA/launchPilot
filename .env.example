# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude AI
ANTHROPIC_API_KEY=sk-ant-your-key

# Stripe
STRIPE_SECRET_KEY=sk_live_your-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_GROWTH_PRICE_ID=price_growth
STRIPE_AGENCY_PRICE_ID=price_agency

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:3000/api/auth/twitter/callback
RESEND_API_KEY=
RESEND_FROM_EMAIL=outreach@mail.launchpilot.co
ENCRYPTION_KEY=replace-with-a-random-32-char-string

# Cron (set a random secret to secure /api/cron/* endpoints)
CRON_SECRET=your-random-cron-secret

# Admin / Self-marketing
# ADMIN_EMAIL gates access to /admin/self-marketing
ADMIN_EMAIL=you@yourdomain.com
# Twitter handle used by the LaunchPilot self-marketing engine (no @ prefix)
SELF_MARKETING_TWITTER_HANDLE=launchpilot

  ! echo ZF80QzlpcWNWMGhvbWVxb0MzUmw6MTpjaQ | vercel env add TWITTER_CLIENT_ID production --force
  ! echo gleXC3A6i77hiqGQAmSGG3Om_8wmEEnpWG_i6kRYQE0OzEN5hk | vercel env add TWITTER_CLIENT_SECRET production --force
  ! vercel --prod --yes

