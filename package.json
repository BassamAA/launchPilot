{
  "name": "launchpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next .next-e2e .next-smoke && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "qa:migrations": "node scripts/check-migrations.mjs",
    "qa:smoke": "node scripts/smoke.mjs",
    "qa": "npm run lint && npm run typecheck && npm run test:run && npm run qa:migrations && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@heroicons/react": "^2.2.0",
    "@stripe/stripe-js": "^4.7.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.2",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "resend": "^6.9.4",
    "stripe": "^17.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.4"
  }
}
